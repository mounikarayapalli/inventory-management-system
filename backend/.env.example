# Application Settings
PROJECT_NAME="Calibo Stock & Inventory Management"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Settings
HOST="0.0.0.0"
PORT=8000

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_DB="calibo_inventory"

# Optional explicit Database URL (overrides individual postgres settings above if provided)
# DATABASE_URL="postgresql+psycopg2://postgres:your_postgres_password_here@localhost:5432/calibo_inventory"

# CORS Settings (JSON encoded list of allowed origins)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:8000"]'

# JWT Authentication Settings
SECRET_KEY="replace-with-a-strong-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
